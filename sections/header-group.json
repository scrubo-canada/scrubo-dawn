      "settings": {
        "custom_liquid": "<!--\n  Scrubo Videos page — DRAFT 17 Nov 2026\n  Suggested URL: https://scrubo.ca/pages/videos\n\n  Paste this entire file into a Shopify Custom Liquid section on a new\n  (unpublished) page. Do not paste into the rich-text page editor; Dawn\n  may strip the <style> and <script> tags.\n\n  This file does not publish or change anything by itself. Leave the\n  Shopify page as a draft until Jason approves it.\n\n  Video lists are in the <script> at the bottom (easy to edit). When\n  YouTube playlists exist, see the comment there for videoseries?list=.\n-->\n<style>\n/* Dawn default page template clash (body-only; no theme edit).\n   Theme wraps content in .page-width--narrow and prints an H1 above\n   the body. Hide that title and go full width when this page is present. */\n.page-width--narrow:has(.sc-page){max-width:none !important;width:100%;padding-left:0 !important;padding-right:0 !important}\n.page-width--narrow:has(.sc-page) > .main-page-title,\n.page-width--narrow:has(.sc-page) .main-page-title{display:none !important;margin:0 !important}\ndiv[class*=\"-padding\"]:has(.sc-page){padding-top:0 !important;padding-bottom:0 !important}\n.rte:has(.sc-page){max-width:none}\n.rte .sc-page img{border:0;box-shadow:none;margin-bottom:0;border-radius:unset;height:auto;max-width:100%}\n.rte .sc-page a{color:inherit;text-decoration:none;text-underline-offset:unset;text-decoration-thickness:unset}\n.rte .sc-page a:hover{color:inherit;text-decoration:none}\n.rte .sc-page ul,.rte .sc-page ol{list-style-position:initial;padding-left:0;margin:0}\n.rte .sc-page button{font:inherit}\n\n.sc-page{color:#1d2230;line-height:1.6;font-size:16px;-webkit-font-smoothing:antialiased;font-family:var(--font-body-family,\"Instrument Sans\",Arial,sans-serif)}\n.sc-page *{box-sizing:border-box}\n.sc-page a{color:#334FB4}\n.sc-wrap{max-width:1100px;margin:0 auto;padding:0 24px}\n.sc-page h1,.sc-page h2,.sc-page h3{font-family:var(--font-heading-family,\"Source Sans Pro\",sans-serif);letter-spacing:.01em;line-height:1.15;margin:0 0 .5em;color:#1b2a41}\n\n/* video library (page starts here) */\n.sc-vids{background:#f3f4f7;padding:32px 0 36px;margin:0}\n.sc-vids-heading{font-family:var(--font-heading-family,\"Source Sans Pro\",sans-serif);font-size:42px;text-transform:uppercase;font-weight:700;letter-spacing:.04em;line-height:1.15;color:#334FB4;margin:0 0 18px}\n\n/* tab toggle */\n.sc-tabs{display:flex;gap:0;background:#fff;border:1.5px solid #d3d8e2;border-radius:999px;padding:4px;width:max-content;max-width:100%;margin:0 0 18px;box-shadow:0 1px 2px rgba(28,40,70,.04)}\n.sc-tab{appearance:none;-webkit-appearance:none;border:0;background:transparent;font-family:inherit;font-weight:700;font-size:15px;padding:10px 22px;border-radius:999px;cursor:pointer;color:#1b2a41;display:inline-flex;align-items:center;gap:8px;line-height:1.2}\n.sc-tab:hover{color:#334FB4}\n.sc-tab:focus-visible{outline:2px solid #334FB4;outline-offset:2px}\n.sc-tab[aria-selected=\"true\"]{background:#334FB4;color:#fff}\n.sc-tab[aria-selected=\"true\"]:hover{color:#fff}\n.sc-tab-count{display:inline-flex;align-items:center;justify-content:center;min-width:22px;height:22px;padding:0 6px;border-radius:999px;background:#DBEAFF;color:#2f496c;font-size:12px;font-weight:700}\n.sc-tab[aria-selected=\"true\"] .sc-tab-count{background:rgba(255,255,255,.22);color:#fff}\n\n/* big player */\n.sc-player{background:#fff;border:1px solid #dde1ea;border-radius:14px;overflow:hidden}\n.sc-player-stage{position:relative;aspect-ratio:16/9;background:#111;overflow:hidden}\n.sc-player-stage iframe{position:absolute;inset:0;width:100%;height:100%;border:0;display:block}\n.sc-poster{position:absolute;inset:0;width:100%;height:100%;padding:0;border:0;background:#111;cursor:pointer;display:block}\n.sc-poster:focus-visible{outline:3px solid #334FB4;outline-offset:-3px}\n.sc-poster img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;display:block}\n.sc-play{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);display:block;line-height:0;filter:drop-shadow(0 2px 6px rgba(0,0,0,.4));pointer-events:none}\n.sc-dur{position:absolute;right:10px;bottom:10px;background:rgba(0,0,0,.8);color:#fff;font-size:13px;font-weight:600;padding:2px 7px;border-radius:4px;pointer-events:none}\n.sc-player-meta{padding:14px 18px 16px;display:flex;align-items:flex-start;justify-content:space-between;gap:16px}\n.sc-player-title{font-family:var(--font-heading-family,\"Source Sans Pro\",sans-serif);font-size:20px;font-weight:700;color:#1b2a41;margin:0;line-height:1.3;flex:1}\n.sc-player-yt{flex:0 0 auto;font-size:13.5px;font-weight:700;color:#334FB4!important;text-decoration:none;white-space:nowrap;padding-top:3px}\n.sc-player-yt:hover{text-decoration:underline}\n\n/* carousel */\n.sc-car{position:relative;margin-top:16px}\n.sc-car-track{display:flex;gap:12px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;-webkit-overflow-scrolling:touch;scrollbar-width:thin;scrollbar-color:#c5cad6 transparent;padding:4px 44px 12px;overscroll-behavior-x:contain}\n.sc-car-item{flex:0 0 210px;scroll-snap-align:start;border:2px solid #dde1ea;border-radius:12px;overflow:hidden;background:#fff;cursor:pointer;text-align:left;padding:0;font:inherit;color:inherit;display:block;box-shadow:0 1px 2px rgba(28,40,70,.05)}\n.sc-car-item:hover{border-color:#334FB4}\n.sc-car-item:focus-visible{outline:2px solid #334FB4;outline-offset:2px}\n.sc-car-item.is-on{border-color:#334FB4;box-shadow:0 0 0 2px rgba(51,79,180,.25)}\n.sc-car-thumb{display:block;position:relative;aspect-ratio:16/9;overflow:hidden;background:#111}\n.sc-car-thumb img{width:100%;height:100%;object-fit:cover;object-position:center;display:block}\n.sc-car-thumb .sc-play svg{width:46px;height:32px}\n.sc-car-thumb .sc-dur{font-size:11px;right:6px;bottom:6px;padding:1px 5px}\n.sc-car-title{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;line-clamp:2;overflow:hidden;font-weight:700;font-size:13px;line-height:1.35;padding:8px 10px 10px;color:#1b2a41;min-height:calc(1.35em * 2 + 18px)}\n.sc-car-btn{position:absolute;top:28%;transform:translateY(-50%);width:36px;height:36px;border:0;border-radius:50%;background:#fff;color:#1b2a41;box-shadow:0 1px 6px rgba(28,40,70,.28);cursor:pointer;display:flex;align-items:center;justify-content:center;padding:0;z-index:2}\n.sc-car-btn:hover,.sc-car-btn:focus-visible{background:#334FB4;color:#fff;outline:none}\n.sc-car-btn[disabled]{opacity:0;pointer-events:none;cursor:default}\n.sc-car-prev{left:4px}\n.sc-car-next{right:4px}\n.sc-car-status{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}\n\n.sc-car-title{hyphens:manual;overflow-wrap:normal;word-break:normal}\n@media print{\n  .sc-vids-heading,.sc-tabs,.sc-player{break-after:avoid;break-inside:avoid}\n  .sc-car-track{display:grid !important;grid-template-columns:repeat(3,1fr);overflow:visible !important;padding:4px 0 8px !important;gap:12px;scrollbar-width:none}\n  .sc-car-item{flex:none !important;width:auto !important;break-inside:avoid}\n  .sc-car-btn{display:none !important}\n}\n\n\n@media screen and (max-width:800px){\n  .sc-vids{padding:24px 0 32px}\n  .sc-vids-heading{font-size:32px}\n  .sc-tabs{width:100%}\n  .sc-tab{flex:1 1 50%;justify-content:center;padding:10px 10px;font-size:14px}\n  .sc-player-meta{flex-direction:column;gap:6px;padding:12px 14px 14px}\n  .sc-player-title{font-size:18px}\n  .sc-car-item{flex:0 0 168px}\n  .sc-car-title{font-size:12.5px}\n}\n@media (prefers-reduced-motion:reduce){\n  .sc-car-track{scroll-behavior:auto}\n}\n</style>\n\n<div class=\"sc-page\" id=\"scrubo-videos\">\n\n  <section class=\"sc-vids\" id=\"sc-video-library\" aria-labelledby=\"sc-vids-heading\">\n    <div class=\"sc-wrap\">\n      <h1 class=\"sc-vids-heading\" id=\"sc-vids-heading\">Video library</h1>\n\n      <div class=\"sc-tabs\" role=\"tablist\" aria-label=\"Video category\">\n        <button type=\"button\" class=\"sc-tab\" role=\"tab\" id=\"sc-tab-product\" aria-controls=\"sc-tabpanel\" aria-selected=\"true\" data-sc-tab=\"product\">\n          Product Videos <span class=\"sc-tab-count\" data-sc-count=\"product\">0</span>\n        </button>\n        <button type=\"button\" class=\"sc-tab\" role=\"tab\" id=\"sc-tab-support\" aria-controls=\"sc-tabpanel\" aria-selected=\"false\" data-sc-tab=\"support\">\n          Support Videos <span class=\"sc-tab-count\" data-sc-count=\"support\">0</span>\n        </button>\n      </div>\n\n      <div class=\"sc-tabpanel\" id=\"sc-tabpanel\" role=\"tabpanel\" aria-labelledby=\"sc-tab-product\">\n        <div class=\"sc-player\">\n          <div class=\"sc-player-stage\" id=\"sc-player-stage\">\n            <!-- Poster or iframe is filled in by the script below. The iframe\n                 is not inserted until someone clicks Play (privacy / lazy-load). -->\n          </div>\n          <div class=\"sc-player-meta\">\n            <h2 class=\"sc-player-title\" id=\"sc-player-title\">Loading videos…</h2>\n            <a class=\"sc-player-yt\" id=\"sc-player-yt\" href=\"https://www.youtube.com/@Scrubo-America\" target=\"_blank\" rel=\"noopener\">Watch on YouTube</a>\n          </div>\n        </div>\n\n        <div class=\"sc-car\" id=\"sc-car\">\n          <button type=\"button\" class=\"sc-car-btn sc-car-prev\" id=\"sc-car-prev\" aria-label=\"Previous videos\">\n            <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M15 18l-6-6 6-6\"/></svg>\n          </button>\n          <div class=\"sc-car-track\" id=\"sc-car-track\" tabindex=\"0\" aria-label=\"Video thumbnails\"></div>\n          <button type=\"button\" class=\"sc-car-btn sc-car-next\" id=\"sc-car-next\" aria-label=\"Next videos\">\n            <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M9 18l6-6-6-6\"/></svg>\n          </button>\n          <div class=\"sc-car-status\" id=\"sc-car-status\" aria-live=\"polite\"></div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n</div>\n\n<script>\n(function(){\n  /* =====================================================================\n     VIDEO LISTS — edit these arrays to add, remove or recategorize videos.\n     Each item: { id: 'YouTube video ID', title: '...', duration: 'm:ss' }\n\n     Hardcoded 17 Nov 2026 from the Scrubo-America channel\n     (https://www.youtube.com/@Scrubo-America,\n      channel ID UCuopy9GHzAliFbMbFGqSGeA). Stand-On 28 and CleanRider 28\n     videos are left out on purpose (none were on the channel that day).\n\n     Once Jason creates YouTube playlists named \"Support Videos\" and\n     \"Product Videos\", you can:\n\n       1. Keep using these arrays (recommended). The thumbnail carousel\n          and click-to-load player need a list of IDs and titles. When\n          you add a video to a playlist, paste its ID and title here too.\n\n       2. Optionally paste the playlist IDs into SUPPORT_PLAYLIST_ID and\n          PRODUCT_PLAYLIST_ID below. The big player will then use\n          YouTube's privacy-enhanced playlist embed:\n\n            https://www.youtube-nocookie.com/embed/VIDEO_ID?list=PLAYLIST_ID\n\n          (The generic form is /embed/videoseries?list=PLAYLIST_ID if you\n          ever want to embed the whole playlist with no starting video.)\n\n       RSS for new uploads:\n         https://www.youtube.com/feeds/videos.xml?channel_id=UCuopy9GHzAliFbMbFGqSGeA\n     ===================================================================== */\n  var SUPPORT_PLAYLIST_ID = ''; // e.g. 'PLxxxxxxxxxxxxxxxxxxxx'\n  var PRODUCT_PLAYLIST_ID = '';\n\n  var VIDEOS = {\n    support: [\n      {id:'hUCRZ2SfQoU', title:'Pad Installation', duration:'0:43'},\n      {id:'0WztrOPJxTY', title:'Solenoid Valve Replacement (Pristine 16)', duration:'4:13'},\n      {id:'XMSwVSSfa2g', title:'Traction Drive Controller', duration:'0:43'},\n      {id:'tLtoc9gpUmI', title:'Throttle Lever Spring Action', duration:'0:11'},\n      {id:'dHrDnIKwxlY', title:'Pristine 20 Pro Key Lock Wiring Check | Fix No Power to Drive or Display', duration:'0:46'},\n      {id:'Py9vrn1_FUE', title:'How to Fix a Floor Scrubber That Won’t Dispense Water. Solenoid Valve Replacement', duration:'2:09'},\n      {id:'cBEcbzLepXA', title:'How to Fix a Floor Scrubber That Pulls Right During Operation', duration:'1:02'},\n      {id:'1_mWoCNTSNc', title:'Scrubo Pristine 16 Motor Repair – Loud Vacuum Noise Problem', duration:'0:54'},\n      {id:'6O14Ir89pIE', title:'Replacing Vacuum Motor on Scrubo Pristine 18 Floor Scrubber', duration:'1:28'},\n      {id:'bQGVZtijto0', title:'Vacuum Motor Troubleshooting for SCRUBO Commercial Floor Scrubbers', duration:'1:53'},\n      {id:'OiCP9yfBGt4', title:'Unboxing and Setup Scrubo Pristine 14 Commercial Floor Scrubber', duration:'2:17'},\n      {id:'tHn-YRqQY0A', title:'Unboxing and setup for Scrubo Pristine 18 Floor Scrubber', duration:'3:11'},\n      {id:'Cj31kOHrP7A', title:'How to Fix Water Tank Leak on Pristine 20', duration:'0:33'},\n      {id:'gOrPtNAq8B0', title:'Troubleshooting electric issue on Pristine 20/20 Pro Floor Scrubber', duration:'0:31'},\n      {id:'OKPoJ5ftNKk', title:'Vacuum Motor Troubleshooting on Scrubo Pristine 20/20 Pro', duration:'1:02'},\n      {id:'oefR4F4Mb-U', title:'Scrubo Pristine 20 - Brush mounting bracket installation.', duration:'1:01'},\n      {id:'mb6NqkH5hDY', title:'How to remove the brush on Scrubo Pristine 20/20 Pro Floor Scrubber', duration:'0:29'},\n      {id:'PG6E189y1D0', title:'Unboxing and setup for Scrubo Pristine 16 Walk Behind Floor Scrubber', duration:'2:20'},\n      {id:'QSpmRrrYTQk', title:'How to remove the brush on Scrubo Floor Scubber', duration:'0:23'},\n      {id:'JKioFCr2Pek', title:'Scrubo Pristine 20 Operating Instructions', duration:'0:28'}\n    ],\n    product: [\n      {id:'GA8T5iUdTCM', title:'Scrubo Polaris Battery Operated Commercial Floor Sweeper', duration:'1:50'},\n      {id:'tHn-YRqQY0A', title:'Unboxing and setup for Scrubo Pristine 18 Floor Scrubber', duration:'3:11'},\n      {id:'DaoTu_x1TaE', title:'Scrubo Pristine 14 Commercial Floor Scrubber', duration:'1:48'},\n      {id:'Jtkv_517az8', title:'Scrubo Pristine 20 Pro', duration:'0:58'},\n      {id:'mTaareaAtis', title:'Scrubo Pristine 26 Pro - Self Propelled Industrial Floor Scrubber', duration:'2:01'},\n      {id:'vjaL2NPxP4g', title:'Scrubo Vortex 17 Commercial Floor Polisher', duration:'0:57'},\n      {id:'PG6E189y1D0', title:'Unboxing and setup for Scrubo Pristine 16 Walk Behind Floor Scrubber', duration:'2:20'},\n      {id:'mfIrxgaU1_Y', title:'Ride-On Floor Scrubber Scrubo CleanRider 26', duration:'1:31'},\n      {id:'12b5t7sKonc', title:'Scrubo Pristine 18 Walk Behind Floor Scrubber', duration:'1:43'},\n      {id:'yt10VgwA_X4', title:'Scrubo Pristine 20 Walk Behind Floor Scrubber', duration:'2:01'},\n      {id:'nHWeeG0vimA', title:'Scrubo Flex Commercial Floor Scrubber', duration:'1:45'},\n      {id:'gnf-InuLvWA', title:'Walk Behind Floor Scrubber Scrubo Pristine 16', duration:'1:15'},\n      {id:'K6ScQiAzPuk', title:'Scrubo Pristine 16', duration:'0:31'},\n      {id:'QDVy_GRTovw', title:'Scrubo Flex Portable Walk-Behind Floor Scrubber', duration:'0:37'},\n      {id:'QPAU1C0kFsQ', title:'Scrubo Flex Compact Walk-Behind Scrubber with Li-ion battery', duration:'1:07'},\n      {id:'3wvqREM5ABg', title:'Scrubo Sweep Manual Floor Sweeper', duration:'0:33'},\n      {id:'_sZR5WsOioY', title:'Scrubo Pristine 20 Walk Behind Floor Scrubber', duration:'1:05'},\n      {id:'JKioFCr2Pek', title:'Scrubo Pristine 20 Operating Instructions', duration:'0:28'}\n    ]\n  };\n\n  var YT_PLAY = '<span class=\"sc-play\" aria-hidden=\"true\"><svg viewBox=\"0 0 68 48\" width=\"68\" height=\"48\"><path d=\"M66.5 7.7a8.5 8.5 0 0 0-6-6C55.2.2 34 .2 34 .2S12.8.2 7.5 1.7a8.5 8.5 0 0 0-6 6C0 13 0 24 0 24s0 11 1.5 16.3a8.5 8.5 0 0 0 6 6C12.8 47.8 34 47.8 34 47.8s21.2 0 26.5-1.5a8.5 8.5 0 0 0 6-6C68 35 68 24 68 24s0-11-1.5-16.3z\" fill=\"#ff0000\"/><path d=\"M45 24 27 14v20\" fill=\"#fff\"/></svg></span>';\n  var YT_PLAY_SM = '<span class=\"sc-play\" aria-hidden=\"true\"><svg viewBox=\"0 0 68 48\" width=\"46\" height=\"32\"><path d=\"M66.5 7.7a8.5 8.5 0 0 0-6-6C55.2.2 34 .2 34 .2S12.8.2 7.5 1.7a8.5 8.5 0 0 0-6 6C0 13 0 24 0 24s0 11 1.5 16.3a8.5 8.5 0 0 0 6 6C12.8 47.8 34 47.8 34 47.8s21.2 0 26.5-1.5a8.5 8.5 0 0 0 6-6C68 35 68 24 68 24s0-11-1.5-16.3z\" fill=\"#ff0000\"/><path d=\"M45 24 27 14v20\" fill=\"#fff\"/></svg></span>';\n\n  var root = document.getElementById('scrubo-videos');\n  if (!root) return;\n\n  var tab = 'product';\n  var current = null;\n  var playing = false;\n  var stage = document.getElementById('sc-player-stage');\n  var titleEl = document.getElementById('sc-player-title');\n  var ytLink = document.getElementById('sc-player-yt');\n  var track = document.getElementById('sc-car-track');\n  var statusEl = document.getElementById('sc-car-status');\n  var tabpanel = document.getElementById('sc-tabpanel');\n\n  function thumbUrl(id){\n    return 'https://i.ytimg.com/vi/' + id + '/hqdefault.jpg';\n  }\n  function playlistId(){\n    return tab === 'support' ? SUPPORT_PLAYLIST_ID : PRODUCT_PLAYLIST_ID;\n  }\n  function embedUrl(id, autoplay){\n    var url = 'https://www.youtube-nocookie.com/embed/' + encodeURIComponent(id) +\n      '?rel=0&modestbranding=1' + (autoplay ? '&autoplay=1' : '');\n    var list = playlistId();\n    if (list) url += '&list=' + encodeURIComponent(list);\n    return url;\n  }\n  function escapeHtml(s){\n    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;');\n  }\n\n  function setTab(next, opts){\n    opts = opts || {};\n    tab = next;\n    var buttons = root.querySelectorAll('.sc-tab[data-sc-tab]');\n    for (var i = 0; i < buttons.length; i++){\n      var on = buttons[i].getAttribute('data-sc-tab') === tab;\n      buttons[i].setAttribute('aria-selected', on ? 'true' : 'false');\n    }\n    if (tabpanel){\n      tabpanel.setAttribute('aria-labelledby', tab === 'support' ? 'sc-tab-support' : 'sc-tab-product');\n    }\n    renderCarousel();\n    var list = VIDEOS[tab] || [];\n    playing = false;\n    selectVideo(list[0] || null, {autoplay:false, announce: !opts.silent});\n    if (track) track.scrollLeft = 0;\n    updateNav();\n  }\n\n  function renderCounts(){\n    var s = root.querySelector('[data-sc-count=\"support\"]');\n    var p = root.querySelector('[data-sc-count=\"product\"]');\n    if (s) s.textContent = String((VIDEOS.support || []).length);\n    if (p) p.textContent = String((VIDEOS.product || []).length);\n  }\n\n  function renderCarousel(){\n    var list = VIDEOS[tab] || [];\n    var html = '';\n    for (var i = 0; i < list.length; i++){\n      var v = list[i];\n      html += '<button type=\"button\" class=\"sc-car-item\" data-sc-id=\"' + escapeHtml(v.id) + '\" aria-label=\"Play ' + escapeHtml(v.title) + ' (' + escapeHtml(v.duration) + ')\">' +\n        '<span class=\"sc-car-thumb\">' +\n          '<img src=\"' + thumbUrl(v.id) + '\" alt=\"\" width=\"320\" height=\"180\" loading=\"lazy\" decoding=\"async\">' +\n          YT_PLAY_SM +\n          '<span class=\"sc-dur\">' + escapeHtml(v.duration) + '</span>' +\n        '</span>' +\n        '<span class=\"sc-car-title\">' + escapeHtml(v.title) + '</span>' +\n      '</button>';\n    }\n    track.innerHTML = html;\n  }\n\n  function markActive(){\n    var items = track.querySelectorAll('.sc-car-item');\n    for (var i = 0; i < items.length; i++){\n      var on = current && items[i].getAttribute('data-sc-id') === current.id;\n      items[i].classList.toggle('is-on', !!on);\n      if (on) items[i].setAttribute('aria-current', 'true');\n      else items[i].removeAttribute('aria-current');\n    }\n  }\n\n  function renderPoster(){\n    if (!current){\n      stage.innerHTML = '<p style=\"color:#fff;padding:24px;margin:0\">No videos in this list yet.</p>';\n      titleEl.textContent = 'No videos';\n      return;\n    }\n    playing = false;\n    var label = 'Play video: ' + current.title;\n    stage.innerHTML = '<button type=\"button\" class=\"sc-poster\" id=\"sc-poster\" aria-label=\"' + escapeHtml(label) + '\">' +\n      '<img src=\"' + thumbUrl(current.id) + '\" alt=\"\" width=\"1280\" height=\"720\" decoding=\"async\">' +\n      YT_PLAY +\n      '<span class=\"sc-dur\">' + escapeHtml(current.duration) + '</span>' +\n    '</button>';\n  }\n\n  function loadIframe(autoplay){\n    if (!current) return;\n    playing = true;\n    var iframe = document.createElement('iframe');\n    iframe.src = embedUrl(current.id, !!autoplay);\n    iframe.title = current.title;\n    iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';\n    iframe.setAttribute('allowfullscreen', '');\n    iframe.setAttribute('referrerpolicy', 'strict-origin-when-cross-origin');\n    stage.innerHTML = '';\n    stage.appendChild(iframe);\n  }\n\n  function selectVideo(video, opts){\n    opts = opts || {};\n    current = video;\n    if (!current){\n      renderPoster();\n      return;\n    }\n    titleEl.textContent = current.title;\n    ytLink.href = 'https://www.youtube.com/watch?v=' + encodeURIComponent(current.id);\n    ytLink.textContent = 'Watch on YouTube';\n    if (opts.autoplay){\n      loadIframe(true);\n    } else {\n      renderPoster();\n    }\n    markActive();\n    if (opts.announce !== false && statusEl){\n      statusEl.textContent = current.title;\n    }\n    if (opts.scrollThumb){\n      var active = track.querySelector('.sc-car-item.is-on');\n      if (active && active.scrollIntoView){\n        active.scrollIntoView({behavior: 'smooth', inline: 'nearest', block: 'nearest'});\n      }\n    }\n  }\n\n  function playCurrent(){\n    loadIframe(true);\n  }\n\n  function updateNav(){\n    var prev = document.getElementById('sc-car-prev');\n    var next = document.getElementById('sc-car-next');\n    if (!prev || !next || !track) return;\n    var pad = parseFloat(window.getComputedStyle(track).paddingLeft) || 0;\n    var max = Math.max(0, track.scrollWidth - track.clientWidth - 2);\n    prev.disabled = track.scrollLeft <= pad + 2;\n    next.disabled = track.scrollLeft >= max;\n  }\n\n  function scrollCar(dir){\n    var amount = Math.max(200, Math.floor(track.clientWidth * 0.8));\n    track.scrollBy({left: dir * amount, behavior: 'smooth'});\n  }\n\n  root.addEventListener('click', function(e){\n    var el = e.target;\n    if (el && el.nodeType !== 1) el = el.parentElement;\n    if (!el) return;\n    var t = el;\n    var tabBtn = t.closest ? t.closest('.sc-tab[data-sc-tab]') : null;\n    if (tabBtn){\n      setTab(tabBtn.getAttribute('data-sc-tab'));\n      return;\n    }\n    if (t.closest && t.closest('#sc-poster')){\n      playCurrent();\n      return;\n    }\n    var item = el.closest ? el.closest('.sc-car-item') : null;\n    if (item){\n      var id = item.getAttribute('data-sc-id');\n      var list = VIDEOS[tab] || [];\n      for (var i = 0; i < list.length; i++){\n        if (list[i].id === id){\n          /* Thumbnail click loads that clip in the big player and starts it\n             (one click to watch). The iframe is created only at this point. */\n          selectVideo(list[i], {autoplay:true, scrollThumb:true});\n          break;\n        }\n      }\n    }\n  });\n\n  document.getElementById('sc-car-prev').addEventListener('click', function(){ scrollCar(-1); });\n  document.getElementById('sc-car-next').addEventListener('click', function(){ scrollCar(1); });\n  track.addEventListener('scroll', updateNav);\n  window.addEventListener('resize', updateNav);\n\n  renderCounts();\n  setTab('product', {silent:true});\n})();\n</script>",
