{% doc %}
  @prompt
    Make YouTube Video gallery. I should be able to put my Youtube video channel name. Make carousel for 2 video lists., make it dynamic so the video get populated directly from my Youtube channel
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign channel_id = block.settings.channel_id | strip %}
{% assign uploads_playlist = channel_id | replace_first: 'UC', 'UU' %}

{% style %}
  .ai-channel-gallery-{{ ai_gen_id }} { display: block; width: {{ block.settings.desktop_width_percent }}%; max-width: 100%; color: #121212; font-family: inherit; }
  .ai-channel-gallery-{{ ai_gen_id }}__heading { margin: 0 0 8px; font-size: 28px; line-height: 1.2; }
  .ai-channel-gallery-{{ ai_gen_id }}__channel { margin: 0 0 22px; }
  .ai-channel-gallery-{{ ai_gen_id }}__channel a { color: #253c8f; text-underline-offset: 3px; }
  .ai-channel-gallery-{{ ai_gen_id }}__tabs { display: flex; gap: 10px; margin: 0 0 18px; }
  .ai-channel-gallery-{{ ai_gen_id }}__tab { border: 1px solid #121212; border-radius: 6px; padding: 10px 16px; background: #fff; color: #121212; font: inherit; cursor: pointer; }
  .ai-channel-gallery-{{ ai_gen_id }}__tab[aria-selected="true"] { background: #334fb4; border-color: #334fb4; color: #fff; }
  .ai-channel-gallery-{{ ai_gen_id }}__panel { display: none; }
  .ai-channel-gallery-{{ ai_gen_id }}__panel.is-active { display: block; }
  .ai-channel-gallery-{{ ai_gen_id }}__player { position: relative; width: 100%; aspect-ratio: 16 / 9; background: #f3f3f3; border-radius: 6px; overflow: hidden; }
  .ai-channel-gallery-{{ ai_gen_id }}__player iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .ai-channel-gallery-{{ ai_gen_id }}__empty { padding: 24px; background: #f3f3f3; border-radius: 6px; color: #404040; }
  @media (max-width: 749px) { .ai-channel-gallery-{{ ai_gen_id }}__heading { font-size: 24px; } }
{% endstyle %}

<youtube-channel-gallery-{{ ai_gen_id }} class="ai-channel-gallery-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}<h2 class="ai-channel-gallery-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
  {% if channel_id != blank %}
    <p class="ai-channel-gallery-{{ ai_gen_id }}__channel"><a href="https://www.youtube.com/channel/{{ channel_id | escape }}" target="_blank" rel="noopener noreferrer">{{ block.settings.channel_label | escape }}</a></p>
    <div class="ai-channel-gallery-{{ ai_gen_id }}__tabs" role="tablist" aria-label="YouTube video lists">
      <button type="button" role="tab" class="ai-channel-gallery-{{ ai_gen_id }}__tab" aria-selected="true" data-target="uploads">{{ block.settings.uploads_label | escape }}</button>
      {% if block.settings.second_playlist_id != blank %}<button type="button" role="tab" class="ai-channel-gallery-{{ ai_gen_id }}__tab" aria-selected="false" data-target="second">{{ block.settings.second_label | escape }}</button>{% endif %}
    </div>
    <div class="ai-channel-gallery-{{ ai_gen_id }}__panel is-active" role="tabpanel" data-panel="uploads">
      <div class="ai-channel-gallery-{{ ai_gen_id }}__player"><iframe src="https://www.youtube-nocookie.com/embed/videoseries?list={{ uploads_playlist | escape }}" title="{{ block.settings.uploads_label | escape }}" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div>
    </div>
    {% if block.settings.second_playlist_id != blank %}<div class="ai-channel-gallery-{{ ai_gen_id }}__panel" role="tabpanel" data-panel="second"><div class="ai-channel-gallery-{{ ai_gen_id }}__player"><iframe src="https://www.youtube-nocookie.com/embed/videoseries?list={{ block.settings.second_playlist_id | strip | escape }}" title="{{ block.settings.second_label | escape }}" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div></div>{% endif %}
  {% else %}
    <div class="ai-channel-gallery-{{ ai_gen_id }}__empty">Add your YouTube channel ID in the block settings. The channel ID starts with UC.</div>
  {% endif %}
</youtube-channel-gallery-{{ ai_gen_id }}>

<script>
  (() => {
    const tagName = 'youtube-channel-gallery-{{ ai_gen_id }}';
    if (customElements.get(tagName)) return;
    class YoutubeChannelGallery extends HTMLElement {
      connectedCallback() {
        this.querySelectorAll('[role="tab"]').forEach((tab) => {
          tab.addEventListener('click', () => {
            this.querySelectorAll('[role="tab"]').forEach((item) => item.setAttribute('aria-selected', item === tab ? 'true' : 'false'));
            this.querySelectorAll('[data-panel]').forEach((panel) => panel.classList.toggle('is-active', panel.dataset.panel === tab.dataset.target));
          });
        });
      }
    }
    customElements.define(tagName, YoutubeChannelGallery);
  })();
</script>

{% schema %}
{
  "name": "YouTube channel gallery",
  "settings": [
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Videos" },
    { "type": "text", "id": "channel_id", "label": "YouTube channel ID", "default": "UCxxxxxxxxxxxxxxxxxxxxxx" },
    { "type": "text", "id": "channel_label", "label": "Channel link label", "default": "Visit our YouTube channel" },
    { "type": "text", "id": "uploads_label", "label": "Uploads tab label", "default": "Latest videos" },
    { "type": "header", "content": "Second video list" },
    { "type": "text", "id": "second_label", "label": "Second list label", "default": "Featured videos" },
    { "type": "text", "id": "second_playlist_id", "label": "YouTube playlist ID" }
  ],
  "presets": [{ "name": "YouTube channel gallery" }],
  "tag": null,
  "class": "youtube-channel-gallery-block"
}
{% endschema %}