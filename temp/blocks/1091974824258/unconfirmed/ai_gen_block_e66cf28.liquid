{% doc %}
  @prompt
    Make YouTube Video gallery. I should be able to put my Youtube video channel name. Make carousel for 2 video lists.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-gallery-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: #121212;
    font-family: inherit;
  }
  .ai-video-gallery-{{ ai_gen_id }}__heading { margin: 0 0 8px; font-size: 28px; line-height: 1.2; }
  .ai-video-gallery-{{ ai_gen_id }}__channel { margin: 0 0 24px; }
  .ai-video-gallery-{{ ai_gen_id }}__channel a { color: #253c8f; text-underline-offset: 3px; }
  .ai-video-gallery-{{ ai_gen_id }}__tabs { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 18px; }
  .ai-video-gallery-{{ ai_gen_id }}__tab, .ai-video-gallery-{{ ai_gen_id }}__arrow {
    border: 1px solid #121212; background: #fff; color: #121212; padding: 10px 16px;
    font: inherit; cursor: pointer; border-radius: 6px;
  }
  .ai-video-gallery-{{ ai_gen_id }}__tab[aria-selected="true"] { background: #334fb4; border-color: #334fb4; color: #fff; }
  .ai-video-gallery-{{ ai_gen_id }}__row { display: none; }
  .ai-video-gallery-{{ ai_gen_id }}__row.is-active { display: block; }
  .ai-video-gallery-{{ ai_gen_id }}__track { display: grid; grid-auto-columns: minmax(240px, 1fr); grid-auto-flow: column; gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; padding: 2px 2px 12px; }
  .ai-video-gallery-{{ ai_gen_id }}__card { min-width: 0; scroll-snap-align: start; }
  .ai-video-gallery-{{ ai_gen_id }}__frame { position: relative; width: 100%; aspect-ratio: 16 / 9; background: #f3f3f3; overflow: hidden; border-radius: 6px; }
  .ai-video-gallery-{{ ai_gen_id }}__frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .ai-video-gallery-{{ ai_gen_id }}__title { margin: 10px 0 0; font-size: 16px; font-weight: 600; }
  .ai-video-gallery-{{ ai_gen_id }}__controls { display: flex; justify-content: flex-end; gap: 8px; margin-top: 8px; }
  .ai-video-gallery-{{ ai_gen_id }}__arrow:disabled { opacity: .45; cursor: not-allowed; }
  @media (max-width: 749px) {
    .ai-video-gallery-{{ ai_gen_id }}__heading { font-size: 24px; }
    .ai-video-gallery-{{ ai_gen_id }}__track { grid-auto-columns: minmax(82%, 1fr); }
  }
{% endstyle %}

<youtube-video-gallery-{{ ai_gen_id }} class="ai-video-gallery-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}<h2 class="ai-video-gallery-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
  {% if block.settings.channel_name != blank %}
    {% assign channel_value = block.settings.channel_name | strip %}
    {% if channel_value contains 'http://' or channel_value contains 'https://' %}
      <p class="ai-video-gallery-{{ ai_gen_id }}__channel"><a href="{{ channel_value | escape }}" target="_blank" rel="noopener noreferrer">Visit {{ block.settings.channel_label | default: 'YouTube channel' | escape }}</a></p>
    {% else %}
      <p class="ai-video-gallery-{{ ai_gen_id }}__channel">YouTube: {{ channel_value | escape }}</p>
    {% endif %}
  {% endif %}
  <div class="ai-video-gallery-{{ ai_gen_id }}__tabs" role="tablist" aria-label="Video lists">
    <button class="ai-video-gallery-{{ ai_gen_id }}__tab" type="button" role="tab" aria-selected="true" data-list="one">{{ block.settings.list_one_name | escape }}</button>
    <button class="ai-video-gallery-{{ ai_gen_id }}__tab" type="button" role="tab" aria-selected="false" data-list="two">{{ block.settings.list_two_name | escape }}</button>
  </div>
  {% for list_number in (1..2) %}
    {% assign list_name_key = 'list_' | append: list_number | append: '_name' %}
    {% assign list_title = block.settings[list_name_key] %}
    <section class="ai-video-gallery-{{ ai_gen_id }}__row{% if list_number == 1 %} is-active{% endif %}" data-panel="{% if list_number == 1 %}one{% else %}two{% endif %}" role="tabpanel" aria-label="{{ list_title | escape }}">
      <div class="ai-video-gallery-{{ ai_gen_id }}__track">
        {% for video_number in (1..4) %}
          {% assign id_key = 'list_' | append: list_number | append: '_video_' | append: video_number %}
          {% assign title_key = 'list_' | append: list_number | append: '_title_' | append: video_number %}
          {% assign video_input = block.settings[id_key] | strip %}
          {% assign video_id = video_input %}
          {% if video_input contains 'youtu.be/' %}{% assign video_id = video_input | split: 'youtu.be/' | last | split: '?' | first | split: '/' | first %}{% elsif video_input contains 'youtube.com/watch' %}{% assign video_id = video_input | split: 'v=' | last | split: '&' | first %}{% elsif video_input contains 'youtube.com/embed/' %}{% assign video_id = video_input | split: 'youtube.com/embed/' | last | split: '?' | first | split: '/' | first %}{% elsif video_input contains 'youtube.com/shorts/' %}{% assign video_id = video_input | split: 'youtube.com/shorts/' | last | split: '?' | first | split: '/' | first %}{% endif %}
          {% if video_id != blank %}
            <article class="ai-video-gallery-{{ ai_gen_id }}__card">
              <div class="ai-video-gallery-{{ ai_gen_id }}__frame"><iframe src="https://www.youtube-nocookie.com/embed/{{ video_id | escape }}" title="{{ block.settings[title_key] | default: list_title | escape }}" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div>
              {% if block.settings[title_key] != blank %}<h3 class="ai-video-gallery-{{ ai_gen_id }}__title">{{ block.settings[title_key] | escape }}</h3>{% endif %}
            </article>
          {% endif %}
        {% endfor %}
      </div>
      <div class="ai-video-gallery-{{ ai_gen_id }}__controls">
        <button class="ai-video-gallery-{{ ai_gen_id }}__arrow" type="button" data-direction="prev" aria-label="Scroll {{ list_title | escape }} backward">←</button>
        <button class="ai-video-gallery-{{ ai_gen_id }}__arrow" type="button" data-direction="next" aria-label="Scroll {{ list_title | escape }} forward">→</button>
      </div>
    </section>
  {% endfor %}
</youtube-video-gallery-{{ ai_gen_id }}>

<script>
  (() => {
    const tagName = 'youtube-video-gallery-{{ ai_gen_id }}';
    if (customElements.get(tagName)) return;
    class YoutubeVideoGallery extends HTMLElement {
      connectedCallback() {
        this.querySelectorAll('[role="tab"]').forEach((tab) => {
          tab.addEventListener('click', () => {
            this.querySelectorAll('[role="tab"]').forEach((item) => item.setAttribute('aria-selected', item === tab ? 'true' : 'false'));
            this.querySelectorAll('[data-panel]').forEach((panel) => panel.classList.toggle('is-active', panel.dataset.panel === tab.dataset.list));
          });
        });
        this.querySelectorAll('[data-direction]').forEach((button) => {
          button.addEventListener('click', () => {
            const panel = button.closest('[data-panel]');
            const track = panel.querySelector('.ai-video-gallery-{{ ai_gen_id }}__track');
            track.scrollBy({ left: button.dataset.direction === 'next' ? track.clientWidth * 0.85 : -track.clientWidth * 0.85, behavior: 'smooth' });
          });
        });
      }
    }
    customElements.define(tagName, YoutubeVideoGallery);
  })();
</script>

{% schema %}
{
  "name": "YouTube video gallery",
  "settings": [
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Videos" },
    { "type": "text", "id": "channel_name", "label": "Channel name or URL", "default": "@Scrubo-America" },
    { "type": "text", "id": "channel_label", "label": "Channel link label", "default": "YouTube channel" },
    { "type": "header", "content": "Video list one" },
    { "type": "text", "id": "list_1_name", "label": "List name", "default": "Product videos" },
    { "type": "text", "id": "list_1_video_1", "label": "Video 1 URL or ID" },
    { "type": "text", "id": "list_1_title_1", "label": "Video 1 title" },
    { "type": "text", "id": "list_1_video_2", "label": "Video 2 URL or ID" },
    { "type": "text", "id": "list_1_title_2", "label": "Video 2 title" },
    { "type": "text", "id": "list_1_video_3", "label": "Video 3 URL or ID" },
    { "type": "text", "id": "list_1_title_3", "label": "Video 3 title" },
    { "type": "text", "id": "list_1_video_4", "label": "Video 4 URL or ID" },
    { "type": "text", "id": "list_1_title_4", "label": "Video 4 title" },
    { "type": "header", "content": "Video list two" },
    { "type": "text", "id": "list_2_name", "label": "List name", "default": "How-to videos" },
    { "type": "text", "id": "list_2_video_1", "label": "Video 1 URL or ID" },
    { "type": "text", "id": "list_2_title_1", "label": "Video 1 title" },
    { "type": "text", "id": "list_2_video_2", "label": "Video 2 URL or ID" },
    { "type": "text", "id": "list_2_title_2", "label": "Video 2 title" },
    { "type": "text", "id": "list_2_video_3", "label": "Video 3 URL or ID" },
    { "type": "text", "id": "list_2_title_3", "label": "Video 3 title" },
    { "type": "text", "id": "list_2_video_4", "label": "Video 4 URL or ID" },
    { "type": "text", "id": "list_2_title_4", "label": "Video 4 title" }
  ],
  "presets": [{ "name": "YouTube video gallery" }],
  "tag": null,
  "class": "youtube-video-gallery-block"
}
{% endschema %}