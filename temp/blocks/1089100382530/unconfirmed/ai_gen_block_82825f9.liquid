{% doc %}
  @prompt
    Make an interactive Google map with stores on the map. Each entry should have store name, phone, address. I need to be able to add new stores
    
    , Add search field by city, street or province
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
  .ai-store-map-{{ ai_gen_id }} { display: block; width: {{ block.settings.desktop_width_percent }}%; max-width: 100%; color: #121212; font-family: inherit; }
  .ai-store-map__heading-{{ ai_gen_id }} { margin: 0 0 8px; font-size: 28px; line-height: 1.2; }
  .ai-store-map__intro-{{ ai_gen_id }} { margin: 0 0 20px; }
  .ai-store-map__layout-{{ ai_gen_id }} { display: grid; grid-template-columns: minmax(240px, 0.8fr) minmax(0, 1.7fr); gap: 20px; align-items: stretch; }
  .ai-store-map__sidebar-{{ ai_gen_id }} { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  .ai-store-map__search-{{ ai_gen_id }} { box-sizing: border-box; width: 100%; padding: 12px 14px; border: 1px solid #767676; border-radius: 6px; background: #fff; color: #121212; font: inherit; }
  .ai-store-map__list-{{ ai_gen_id }} { display: flex; flex-direction: column; gap: 10px; max-height: 470px; overflow-y: auto; }
  .ai-store-map__item-{{ ai_gen_id }} { padding: 16px; border: 1px solid #d9dce2; border-radius: 6px; background: #fff; color: #121212; text-align: left; cursor: pointer; font: inherit; }
  .ai-store-map__item-{{ ai_gen_id }}[aria-pressed="true"] { border-color: #334fb4; box-shadow: 0 0 0 1px #334fb4; }
  .ai-store-map__name-{{ ai_gen_id }} { display: block; font-weight: 700; margin-bottom: 6px; }
  .ai-store-map__detail-{{ ai_gen_id }} { display: block; font-size: 14px; line-height: 1.5; }
  .ai-store-map__detail-{{ ai_gen_id }} a { color: #17377f; text-decoration: underline; }
  .ai-store-map__frame-{{ ai_gen_id }} { min-height: 420px; width: 100%; height: 100%; border: 0; border-radius: 6px; background: #f3f3f3; }
  .ai-store-map__status-{{ ai_gen_id }} { margin: 0; }
  .ai-store-map-{{ ai_gen_id }} :focus-visible { outline: 3px solid #17377f; outline-offset: 3px; }
  @media screen and (max-width: 749px) { .ai-store-map__layout-{{ ai_gen_id }} { grid-template-columns: 1fr; } .ai-store-map__list-{{ ai_gen_id }} { max-height: 300px; } .ai-store-map__frame-{{ ai_gen_id }} { min-height: 340px; } }
{% endstyle %}
<store-map-{{ ai_gen_id }} class="ai-store-map-{{ ai_gen_id }}" data-store-data="{{ block.settings.stores_json | escape }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}<h2 class="ai-store-map__heading-{{ ai_gen_id }}">{{ block.settings.heading | escape }}</h2>{% endif %}
  {% if block.settings.intro != blank %}<p class="ai-store-map__intro-{{ ai_gen_id }}">{{ block.settings.intro | escape }}</p>{% endif %}
  <div class="ai-store-map__layout-{{ ai_gen_id }}">
    <div class="ai-store-map__sidebar-{{ ai_gen_id }}">
      <label for="ai-store-search-{{ ai_gen_id }}">Search by city, street, or province</label>
      <input id="ai-store-search-{{ ai_gen_id }}" class="ai-store-map__search-{{ ai_gen_id }}" type="search" placeholder="Enter a city, street, or province" autocomplete="address-level1">
      <div class="ai-store-map__list-{{ ai_gen_id }}" role="group" aria-label="Store locations"></div>
      <p class="ai-store-map__status-{{ ai_gen_id }}" role="status" aria-live="polite" hidden></p>
    </div>
    <iframe class="ai-store-map__frame-{{ ai_gen_id }}" title="Google map showing store location" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
  </div>
</store-map-{{ ai_gen_id }}>
<script>
  (function() {
    var tagName = 'store-map-{{ ai_gen_id }}';
    if (customElements.get(tagName)) return;
    class StoreMap{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        var list = this.querySelector('.ai-store-map__list-{{ ai_gen_id }}');
        var frame = this.querySelector('.ai-store-map__frame-{{ ai_gen_id }}');
        var status = this.querySelector('.ai-store-map__status-{{ ai_gen_id }}');
        var search = this.querySelector('.ai-store-map__search-{{ ai_gen_id }}');
        var stores;
        try { stores = JSON.parse(this.dataset.storeData || '[]'); if (!Array.isArray(stores)) throw new Error('Invalid data'); }
        catch (error) { status.hidden = false; status.textContent = 'Store information could not be read. Check the store list format in the block settings.'; return; }
        stores = stores.filter(function(store) { return store && typeof store.name === 'string' && typeof store.address === 'string' && store.name.trim() && store.address.trim(); });
        if (!stores.length) { status.hidden = false; status.textContent = 'Add stores in the block settings to show locations here.'; frame.hidden = true; search.disabled = true; return; }
        var buttons = [];
        function selectStore(store, selectedButton) {
          buttons.forEach(function(item) { item.button.setAttribute('aria-pressed', item.button === selectedButton ? 'true' : 'false'); });
          frame.src = 'https://maps.google.com/maps?q=' + encodeURIComponent(store.address) + '&output=embed';
          frame.title = 'Google map showing ' + store.name;
        }
        stores.forEach(function(store, index) {
          var button = document.createElement('button');
          button.type = 'button'; button.className = 'ai-store-map__item-{{ ai_gen_id }}'; button.setAttribute('aria-pressed', 'false');
          var name = document.createElement('span'); name.className = 'ai-store-map__name-{{ ai_gen_id }}'; name.textContent = store.name;
          var address = document.createElement('span'); address.className = 'ai-store-map__detail-{{ ai_gen_id }}'; address.textContent = store.address;
          var phone = document.createElement('span'); phone.className = 'ai-store-map__detail-{{ ai_gen_id }}';
          if (store.phone) { var phoneLink = document.createElement('a'); phoneLink.href = 'tel:' + String(store.phone).replace(/[^0-9+]/g, ''); phoneLink.textContent = store.phone; phone.appendChild(phoneLink); }
          button.append(name, address, phone);
          button.addEventListener('click', function() { selectStore(store, button); });
          list.appendChild(button); buttons.push({ button: button, store: store, index: index });
        });
        function filterStores() {
          var term = search.value.trim().toLocaleLowerCase();
          var matches = buttons.filter(function(item) {
            var addressText = item.store.address.toLocaleLowerCase();
            return !term || addressText.indexOf(term) !== -1;
          });
          buttons.forEach(function(item) { item.button.hidden = matches.indexOf(item) === -1; });
          status.hidden = matches.length > 0;
          status.textContent = matches.length ? '' : 'No stores match that location. Try another city, street, or province.';
          if (matches.length && !matches.some(function(item) { return item.button.getAttribute('aria-pressed') === 'true'; })) selectStore(matches[0].store, matches[0].button);
        }
        search.addEventListener('input', filterStores);
        selectStore(stores[0], buttons[0].button);
      }
    }
    customElements.define(tagName, StoreMap{{ ai_gen_id }});
  })();
</script>
{% schema %}
{
  "name": "Store map directory",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find a store" },
    { "type": "text", "id": "intro", "label": "Intro text", "default": "Select a location to view it on the map." },
    { "type": "textarea", "id": "stores_json", "label": "Store list (JSON)", "default": "[{\"name\":\"Store name\",\"phone\":\"+1 555 555 5555\",\"address\":\"123 Main Street, Montreal, QC\"}]", "info": "Add entries as JSON objects with name, phone, and address fields. Separate objects with commas. Search uses each store's address." },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 }
  ],
  "presets": [{ "name": "Store map directory" }],
  "tag": null,
  "class": "store-map-directory"
}
{% endschema %}