{% doc %}
  @prompt
    Make 4 columns images. Every image should have title and subtitle over it. The image and text should be replaceable., make dark gradient at the bottom so the text is more visible
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-grid-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-image-grid-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: {{ block.settings.gap }}px;
  }

  .ai-image-grid-{{ ai_gen_id }}__item {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 3 / 4;
    background: #e8e8e8;
    color: #ffffff;
    text-decoration: none;
    isolation: isolate;
  }

  .ai-image-grid-{{ ai_gen_id }}__image,
  .ai-image-grid-{{ ai_gen_id }}__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .ai-image-grid-{{ ai_gen_id }}__image {
    display: block;
    object-fit: cover;
  }

  .ai-image-grid-{{ ai_gen_id }}__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #e8e8e8;
  }

  .ai-image-grid-{{ ai_gen_id }}__placeholder svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    color: #737373;
  }

  .ai-image-grid-{{ ai_gen_id }}__placeholder-label {
    position: absolute;
    bottom: 12px;
    left: 12px;
    right: 12px;
    color: #333333;
    font-size: 13px;
    text-align: center;
  }

  .ai-image-grid-{{ ai_gen_id }}__item::after {
    content: '';
    position: absolute;
    z-index: 1;
    inset: 35% 0 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.82) 100%);
    pointer-events: none;
  }

  .ai-image-grid-{{ ai_gen_id }}__content {
    position: absolute;
    z-index: 2;
    right: 18px;
    bottom: 18px;
    left: 18px;
    color: #ffffff;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-image-grid-{{ ai_gen_id }}__title {
    margin: 0 0 5px;
    color: #ffffff;
    font-size: {{ block.settings.title_size }}px;
    line-height: 1.15;
    font-weight: 600;
  }

  .ai-image-grid-{{ ai_gen_id }}__subtitle {
    margin: 0;
    color: #ffffff;
    font-size: {{ block.settings.subtitle_size }}px;
    line-height: 1.4;
  }

  @media screen and (max-width: 749px) {
    .ai-image-grid-{{ ai_gen_id }}__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .ai-image-grid-{{ ai_gen_id }}__content {
      right: 12px;
      bottom: 12px;
      left: 12px;
    }

    .ai-image-grid-{{ ai_gen_id }}__title {
      font-size: {{ block.settings.title_size | times: 0.85 | round }}px;
    }

    .ai-image-grid-{{ ai_gen_id }}__subtitle {
      font-size: {{ block.settings.subtitle_size | times: 0.9 | round }}px;
    }
  }

  @media screen and (max-width: 420px) {
    .ai-image-grid-{{ ai_gen_id }}__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

<div class="ai-image-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-image-grid-{{ ai_gen_id }}__grid">
    {% for i in (1..4) %}
      {% liquid
        assign image_key = 'image_' | append: i
        assign title_key = 'title_' | append: i
        assign subtitle_key = 'subtitle_' | append: i
        assign link_key = 'link_' | append: i
        assign card_image = block.settings[image_key]
        assign card_title = block.settings[title_key]
        assign card_subtitle = block.settings[subtitle_key]
        assign card_link = block.settings[link_key]
      %}
      {% if card_link != blank %}
        <a class="ai-image-grid-{{ ai_gen_id }}__item" href="{{ card_link }}" aria-label="{{ card_title | default: card_subtitle | escape }}">
      {% else %}
        <div class="ai-image-grid-{{ ai_gen_id }}__item">
      {% endif %}
        {% if card_image != blank %}
          <img
            class="ai-image-grid-{{ ai_gen_id }}__image"
            src="{{ card_image | image_url: width: 1000 }}"
            alt="{{ card_image.alt | escape }}"
            loading="lazy"
            width="{{ card_image.width }}"
            height="{{ card_image.height }}"
          >
        {% else %}
          <div class="ai-image-grid-{{ ai_gen_id }}__placeholder">
            {{ 'image' | placeholder_svg_tag }}
            <span class="ai-image-grid-{{ ai_gen_id }}__placeholder-label">Add image {{ i }}</span>
          </div>
        {% endif %}
        {% if card_title != blank or card_subtitle != blank %}
          <div class="ai-image-grid-{{ ai_gen_id }}__content">
            {% if card_title != blank %}<h2 class="ai-image-grid-{{ ai_gen_id }}__title">{{ card_title | escape }}</h2>{% endif %}
            {% if card_subtitle != blank %}<p class="ai-image-grid-{{ ai_gen_id }}__subtitle">{{ card_subtitle | escape }}</p>{% endif %}
          </div>
        {% endif %}
      {% if card_link != blank %}</a>{% else %}</div>{% endif %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Four image columns",
  "settings": [
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Column gap",
      "min": 0,
      "max": 32,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 16,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "label": "Subtitle size",
      "min": 12,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Image 1"
    },
    { "type": "image_picker", "id": "image_1", "label": "Image" },
    { "type": "text", "id": "title_1", "label": "Title", "default": "Column one" },
    { "type": "text", "id": "subtitle_1", "label": "Subtitle", "default": "Add a short description" },
    { "type": "url", "id": "link_1", "label": "Link" },
    {
      "type": "header",
      "content": "Image 2"
    },
    { "type": "image_picker", "id": "image_2", "label": "Image" },
    { "type": "text", "id": "title_2", "label": "Title", "default": "Column two" },
    { "type": "text", "id": "subtitle_2", "label": "Subtitle", "default": "Add a short description" },
    { "type": "url", "id": "link_2", "label": "Link" },
    {
      "type": "header",
      "content": "Image 3"
    },
    { "type": "image_picker", "id": "image_3", "label": "Image" },
    { "type": "text", "id": "title_3", "label": "Title", "default": "Column three" },
    { "type": "text", "id": "subtitle_3", "label": "Subtitle", "default": "Add a short description" },
    { "type": "url", "id": "link_3", "label": "Link" },
    {
      "type": "header",
      "content": "Image 4"
    },
    { "type": "image_picker", "id": "image_4", "label": "Image" },
    { "type": "text", "id": "title_4", "label": "Title", "default": "Column four" },
    { "type": "text", "id": "subtitle_4", "label": "Subtitle", "default": "Add a short description" },
    { "type": "url", "id": "link_4", "label": "Link" }
  ],
  "presets": [
    { "name": "Four image columns" }
  ],
  "tag": null,
  "class": "four-image-columns"
}
{% endschema %}