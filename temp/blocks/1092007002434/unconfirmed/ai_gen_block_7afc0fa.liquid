{% doc %}
  @prompt
    Youtube video carousel for my Youtube page Scrubo
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-carousel-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: #121212;
  }
  .ai-video-carousel-{{ ai_gen_id }}__heading { margin: 0 0 8px; color: #121212; }
  .ai-video-carousel-{{ ai_gen_id }}__intro { margin: 0 0 20px; color: #333333; }
  .ai-video-carousel-{{ ai_gen_id }}__top { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 16px; }
  .ai-video-carousel-{{ ai_gen_id }}__top .ai-video-carousel-{{ ai_gen_id }}__heading { margin: 0; }
  .ai-video-carousel-{{ ai_gen_id }}__controls { display: flex; gap: 8px; flex-shrink: 0; }
  .ai-video-carousel-{{ ai_gen_id }}__control { width: 42px; height: 42px; display: inline-flex; align-items: center; justify-content: center; border: 1px solid #777777; border-radius: {{ block.settings.button_radius }}px; background: #ffffff; color: #121212; cursor: pointer; }
  .ai-video-carousel-{{ ai_gen_id }}__control:hover { background: #f3f3f3; }
  .ai-video-carousel-{{ ai_gen_id }}__control:focus-visible, .ai-video-carousel-{{ ai_gen_id }}__link:focus-visible { outline: 3px solid #334fb4; outline-offset: 3px; }
  .ai-video-carousel-{{ ai_gen_id }}__track { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, calc((100% - {{ block.settings.card_gap }}px * ({{ block.settings.desktop_columns }} - 1)) / {{ block.settings.desktop_columns }})); gap: {{ block.settings.card_gap }}px; overflow-x: auto; overscroll-behavior-inline: contain; scroll-snap-type: x mandatory; scrollbar-width: thin; padding: 2px 2px 12px; }
  .ai-video-carousel-{{ ai_gen_id }}__card { min-width: 0; scroll-snap-align: start; }
  .ai-video-carousel-{{ ai_gen_id }}__frame { position: relative; width: 100%; aspect-ratio: 16 / 9; overflow: hidden; background: #f3f3f3; border-radius: {{ block.settings.card_radius }}px; }
  .ai-video-carousel-{{ ai_gen_id }}__frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .ai-video-carousel-{{ ai_gen_id }}__title { margin: 10px 0 0; color: #121212; font-size: 16px; font-weight: 600; }
  .ai-video-carousel-{{ ai_gen_id }}__link { color: #233b91; text-decoration: underline; text-underline-offset: 3px; }
  @media screen and (max-width: 749px) {
    .ai-video-carousel-{{ ai_gen_id }} { width: 100%; }
    .ai-video-carousel-{{ ai_gen_id }}__track { grid-auto-columns: minmax(0, 84%); }
    .ai-video-carousel-{{ ai_gen_id }}__top { align-items: flex-start; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ai-video-carousel-{{ ai_gen_id }}__track { scroll-behavior: auto; }
  }
{% endstyle %}

<youtube-carousel-{{ ai_gen_id }} class="ai-video-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank or block.settings.show_controls %}
    <div class="ai-video-carousel-{{ ai_gen_id }}__top">
      {% if block.settings.heading != blank %}<h2 class="ai-video-carousel-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
      {% if block.settings.show_controls %}
        <div class="ai-video-carousel-{{ ai_gen_id }}__controls" aria-label="Carousel controls">
          <button class="ai-video-carousel-{{ ai_gen_id }}__control" type="button" data-direction="previous" aria-label="Scroll videos left"><span aria-hidden="true">&#8592;</span></button>
          <button class="ai-video-carousel-{{ ai_gen_id }}__control" type="button" data-direction="next" aria-label="Scroll videos right"><span aria-hidden="true">&#8594;</span></button>
        </div>
      {% endif %}
    </div>
  {% endif %}
  {% if block.settings.intro != blank %}<p class="ai-video-carousel-{{ ai_gen_id }}__intro">{{ block.settings.intro | escape }}</p>{% endif %}
  <div class="ai-video-carousel-{{ ai_gen_id }}__track" role="region" aria-label="YouTube videos" tabindex="0">
    {% for i in (1..6) %}
      {% liquid
        assign video_key = 'video_' | append: i
        assign title_key = 'title_' | append: i
        assign video_url = block.settings[video_key] | strip
        assign video_id = ''
        if video_url contains 'youtu.be/'
          assign video_id = video_url | split: 'youtu.be/' | last | split: '?' | first | split: '&' | first
        elsif video_url contains 'youtube.com/embed/'
          assign video_id = video_url | split: 'youtube.com/embed/' | last | split: '?' | first | split: '&' | first
        elsif video_url contains 'youtube.com/watch'
          assign video_id = video_url | split: 'v=' | last | split: '&' | first
        elsif video_url contains 'youtube.com/shorts/'
          assign video_id = video_url | split: 'youtube.com/shorts/' | last | split: '?' | first | split: '&' | first
        endif
        assign video_title = block.settings[title_key]
      %}
      {% if video_id != blank %}
        <article class="ai-video-carousel-{{ ai_gen_id }}__card">
          <div class="ai-video-carousel-{{ ai_gen_id }}__frame">
            <iframe src="https://www.youtube-nocookie.com/embed/{{ video_id | escape }}" title="{{ video_title | default: 'YouTube video' | escape }}" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
          </div>
          {% if video_title != blank %}<h3 class="ai-video-carousel-{{ ai_gen_id }}__title">{{ video_title | escape }}</h3>{% endif %}
        </article>
      {% endif %}
    {% endfor %}
  </div>
  {% if block.settings.channel_url != blank %}<p><a class="ai-video-carousel-{{ ai_gen_id }}__link" href="{{ block.settings.channel_url }}" target="_blank" rel="noopener noreferrer">{{ block.settings.channel_label | escape }}</a></p>{% endif %}
</youtube-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    const elementName = 'youtube-carousel-{{ ai_gen_id }}';
    if (customElements.get(elementName)) return;
    class YoutubeCarousel extends HTMLElement {
      connectedCallback() {
        this.track = this.querySelector('.ai-video-carousel-{{ ai_gen_id }}__track');
        if (!this.track) return;
        this.querySelectorAll('[data-direction]').forEach((button) => {
          button.addEventListener('click', () => {
            const direction = button.dataset.direction === 'next' ? 1 : -1;
            this.track.scrollBy({ left: direction * this.track.clientWidth * 0.85, behavior: 'smooth' });
          });
        });
      }
    }
    customElements.define(elementName, YoutubeCarousel);
  })();
</script>

{% schema %}
{
  "name": "YouTube video carousel",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Scrubo videos" },
    { "type": "text", "id": "intro", "label": "Intro text" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "desktop_columns", "label": "Videos visible on desktop", "min": 1, "max": 4, "step": 1, "default": 3 },
    { "type": "range", "id": "card_gap", "label": "Gap", "min": 8, "max": 40, "step": 4, "unit": "px", "default": 16 },
    { "type": "range", "id": "card_radius", "label": "Video corner radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "button_radius", "label": "Control corner radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 6 },
    { "type": "checkbox", "id": "show_controls", "label": "Show scroll controls", "default": true },
    { "type": "header", "content": "Video 1" },
    { "type": "text", "id": "title_1", "label": "Video title" },
    { "type": "text", "id": "video_1", "label": "YouTube video URL" },
    { "type": "header", "content": "Video 2" },
    { "type": "text", "id": "title_2", "label": "Video title" },
    { "type": "text", "id": "video_2", "label": "YouTube video URL" },
    { "type": "header", "content": "Video 3" },
    { "type": "text", "id": "title_3", "label": "Video title" },
    { "type": "text", "id": "video_3", "label": "YouTube video URL" },
    { "type": "header", "content": "Video 4" },
    { "type": "text", "id": "title_4", "label": "Video title" },
    { "type": "text", "id": "video_4", "label": "YouTube video URL" },
    { "type": "header", "content": "Video 5" },
    { "type": "text", "id": "title_5", "label": "Video title" },
    { "type": "text", "id": "video_5", "label": "YouTube video URL" },
    { "type": "header", "content": "Video 6" },
    { "type": "text", "id": "title_6", "label": "Video title" },
    { "type": "text", "id": "video_6", "label": "YouTube video URL" },
    { "type": "header", "content": "YouTube channel" },
    { "type": "url", "id": "channel_url", "label": "Channel or videos page link" },
    { "type": "text", "id": "channel_label", "label": "Link label", "default": "Visit our YouTube channel" }
  ],
  "presets": [{ "name": "YouTube video carousel" }],
  "tag": null,
  "class": "youtube-video-carousel"
}
{% endschema %}